<?xml version="1.0" encoding="UTF-8"?>
<!-- Runs against the shop sample's application, with its vendor: make test runs it so. -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="../../samples/shop/vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="../../samples/shop/vendor/autoload.php"
         colors="true"
         failOnWarning="true">
    <testsuites>
        <testsuite name="laravel">
            <directory>tests</directory>
        </testsuite>
    </testsuites>
</phpunit>
